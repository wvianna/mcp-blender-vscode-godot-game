[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/input_diagnostic.gd" id="1_diag"]

[node name="InputTest" type="Control"]
process_mode = 3
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_diag")

[node name="Bg" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.05, 0.05, 0.94)

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/VBox"]
theme_override_colors/font_color = Color(0.75, 0.95, 0.8, 1)
theme_override_font_sizes/font_size = 20
text = "CALIBRAÇÃO DE INPUT — LAB 404"

[node name="StatusLabel" type="Label" parent="Margin/VBox"]
theme_override_colors/font_color = Color(0.85, 0.75, 0.5, 1)
theme_override_font_sizes/font_size = 13
text = "hotplug: nenhum evento desde a abertura"

[node name="Columns" type="HBoxContainer" parent="Margin/VBox"]
size_flags_vertical = 3
theme_override_constants/separation = 28

[node name="DevicesCol" type="VBoxContainer" parent="Margin/VBox/Columns"]
size_flags_horizontal = 3

[node name="DevicesTitle" type="Label" parent="Margin/VBox/Columns/DevicesCol"]
theme_override_colors/font_color = Color(0.6, 0.75, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "DISPOSITIVOS"

[node name="DevicesLabel" type="Label" parent="Margin/VBox/Columns/DevicesCol"]
theme_override_font_sizes/font_size = 13
text = "(nenhum joystick conectado)"

[node name="AxesCol" type="VBoxContainer" parent="Margin/VBox/Columns"]
size_flags_horizontal = 3

[node name="AxesTitle" type="Label" parent="Margin/VBox/Columns/AxesCol"]
theme_override_colors/font_color = Color(0.6, 0.75, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "EIXOS"

[node name="AxesLabel" type="Label" parent="Margin/VBox/Columns/AxesCol"]
theme_override_font_sizes/font_size = 13
text = "(sem joystick: eixos indisponíveis)"

[node name="ButtonsCol" type="VBoxContainer" parent="Margin/VBox/Columns"]
size_flags_horizontal = 3

[node name="ButtonsTitle" type="Label" parent="Margin/VBox/Columns/ButtonsCol"]
theme_override_colors/font_color = Color(0.6, 0.75, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "BOTÕES"

[node name="ButtonsLabel" type="Label" parent="Margin/VBox/Columns/ButtonsCol"]
theme_override_font_sizes/font_size = 13
text = "pressionados: [—]"

[node name="DeadzoneRow" type="HBoxContainer" parent="Margin/VBox"]
theme_override_constants/separation = 12

[node name="DeadzoneTitle" type="Label" parent="Margin/VBox/DeadzoneRow"]
theme_override_font_sizes/font_size = 13
text = "ZONA MORTA"

[node name="DeadzoneSlider" type="HSlider" parent="Margin/VBox/DeadzoneRow"]
size_flags_horizontal = 3
size_flags_vertical = 4
max_value = 0.5
step = 0.01
value = 0.15

[node name="DeadzoneValue" type="Label" parent="Margin/VBox/DeadzoneRow"]
custom_minimum_size = Vector2(48, 0)
theme_override_font_sizes/font_size = 13
text = "0.15"

[node name="Spacer" type="Control" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 230)

[node name="Hint" type="Label" parent="Margin/VBox"]
theme_override_colors/font_color = Color(0.65, 0.68, 0.7, 1)
theme_override_font_sizes/font_size = 12
text = "Mova os analógicos. [Q]/[O] ou [Esc]/[Start] fecham esta tela."
