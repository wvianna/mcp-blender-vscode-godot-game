[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/aria_terminal.gd" id="1_terminal"]
[ext_resource type="Script" path="res://scripts/aria_client.gd" id="2_client"]

[node name="ARIATerminal" type="Control"]
process_mode = 3
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_terminal")

[node name="Dim" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.02, 0.88)

[node name="Panel" type="PanelContainer" parent="."]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -380.0
offset_top = -230.0
offset_right = 380.0
offset_bottom = 230.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Panel/Margin/VBox"]
theme_override_colors/font_color = Color(1, 0.72, 0.35, 1)
theme_override_font_sizes/font_size = 15
text = "ARIA // AUTONOMOUS RESEARCH & INDUSTRIAL AI"

[node name="Status" type="Label" parent="Panel/Margin/VBox"]
theme_override_colors/font_color = Color(0.65, 0.75, 0.65, 1)
theme_override_font_sizes/font_size = 12
text = "canal: —"

[node name="History" type="RichTextLabel" parent="Panel/Margin/VBox"]
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
scroll_following = true

[node name="InputRow" type="HBoxContainer" parent="Panel/Margin/VBox"]
theme_override_constants/separation = 8

[node name="Prompt" type="Label" parent="Panel/Margin/VBox/InputRow"]
theme_override_colors/font_color = Color(1, 0.72, 0.35, 1)
theme_override_font_sizes/font_size = 14
text = ">"

[node name="Input" type="LineEdit" parent="Panel/Margin/VBox/InputRow"]
size_flags_horizontal = 3
placeholder_text = "escreva para ARIA e pressione Enter"
max_length = 500

[node name="Hint" type="Label" parent="Panel/Margin/VBox"]
theme_override_colors/font_color = Color(0.6, 0.63, 0.66, 1)
theme_override_font_sizes/font_size = 12
text = "Enter envia — Esc/Q fecha o terminal"

[node name="Client" type="Node" parent="."]
script = ExtResource("2_client")
