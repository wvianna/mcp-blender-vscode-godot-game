; Engine configuration file.
; Projeto: Laboratório 404 (POC 1 — Fundação jogável)
; Convenção: TODO gameplay usa as ações semânticas abaixo (FR-001).
; Nunca consumir índices crus de botão/eixo de joystick fora de `scenes/input_test.tscn`.

config_version=5

[application]

config/name="Laboratório 404"
config/description="Jogo 3D educacional/ficcional — Laboratório 404 (Blender + Godot + Ollama)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

Lab404Game="*res://scripts/game.gd"
Lab404Sfx="*res://scripts/sfx.gd"
Lab404QuitWatch="*res://scripts/quit_watch.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

